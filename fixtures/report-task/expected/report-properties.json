        "replace": "[find, parts]: replace the first occurrence of `find` (which must occur) with the concatenated parts",
        "padToBytes": "append the single-byte string `with` until the UTF-8 length equals the value",
        "crlf": "replace every LF with CRLF",
        "parts": "a part is a string, or {repeat, times}: the string repeated that many times"
