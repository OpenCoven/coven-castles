# Castles preflight binding. Placeholders only: never commit real values.
# Copy to .env.local (git-ignored) or export these in your shell. Exported
# variables win. .env.local is read from the directory the command is run in.
# Every key in that file is loaded into the process environment; only the four
# CASTLES_* keys below are consumed. Keep nothing else in it.
#
# None of these is a secret or an authorization. The sandbox ID is a *target*;
# ownership is decided by the owning service from its authenticated caller.

# The one supported profile.
CASTLES_PROFILE=castles.daytona-private-linux.v1
# Exact ID of the one existing sandbox to check. Never a name or a label.
CASTLES_SANDBOX_ID=<existing-sandbox-id>
# The Coven Agents agent record that canonically owns that sandbox.
CASTLES_OWNER_AGENT_ID=<owning-agent-id>
# The sandbox generation recorded on that agent record.
CASTLES_SANDBOX_GENERATION=<generation-integer>

# --- Secrets are NOT configured here ---------------------------------------
# Castles holds no provider, database, or harness credential, and consumes
# none from its environment. These stay with the owning service (Coven Agents),
# server-side only, and are listed purely as references to where they live:
#
#   DAYTONA_API_KEY            -> Coven Agents server environment
#   database credentials       -> Coven Agents server environment
#   tenant harness credentials -> Coven Agents encrypted custody, staged per attempt
#
# Do not put any of them in this file, in a browser, or in the sandbox.
