#!/bin/sh
# Blocks commits that contain secrets in staged changes.
# Enable once per clone: git config core.hooksPath .githooks

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so staged changes cannot be scanned for secrets." >&2
  echo "Install it (macOS: brew install gitleaks; others: https://github.com/gitleaks/gitleaks#installing) and retry." >&2
  exit 1
fi

if ! gitleaks git --pre-commit --staged --redact --no-banner --verbose; then
  echo >&2
  echo "pre-commit: commit blocked, gitleaks found a possible secret in staged changes." >&2
  echo "Remove it (and rotate it if it was real). For a false positive, add an allowlist" >&2
  echo "entry to .gitleaks.toml or a trailing 'gitleaks:allow' comment on the line." >&2
  exit 1
fi
